# Local core
APP_ENV=development
DEV_IN_MEMORY=1
RUNTIME_STORE=memory
DEV_SEED=0
DEV_OWNER_EMAIL=owner@local.test
DEV_OWNER_PASSWORD=change-me-local
DEV_WORKSPACE_NAME=Local Workspace
DEV_BRAND_NAME=Local Brand
DEV_BRAND_SLUG=local-brand
DEV_BRAND_LANGUAGE=en
DEV_BRAND_TIMEZONE=UTC
DEV_BRAND_CURRENCY=USD
JWT_ACCESS_SECRET=change-me-access-secret
CREDENTIAL_ENCRYPTION_KEY=
API_PORT=4000
API_BIND_HOST=127.0.0.1
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000
COOKIE_SECURE=false
LOCAL_WORKER_INTERVAL_MS=1000
DEV_STORE_FILE=.data/local-store.json
LOCAL_STORE_FLUSH_MS=2000

# PostgreSQL/Redis schema and future cloud runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_v1
REDIS_URL=redis://localhost:6379
PUBLISH_QUEUE_NAME=dsm-publish-api
WORKER_CONCURRENCY=4

# Private S3-compatible media storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=social-v1

# Meta/TikTok API configuration
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Chỉ bật các quyền Meta này sau khi ứng dụng được Meta cấp quyền tương ứng.
# META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata,pages_messaging,instagram_basic,instagram_manage_comments,instagram_manage_messages
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=
# Comment inbox permissions are optional until Meta approves them. Add approved
# scopes to META_OAUTH_SCOPES and reconnect the Page/Instagram account.
# Required for Page feed subscription: pages_manage_metadata.
# Other inbox scopes: pages_manage_engagement,pages_read_user_content,instagram_manage_comments,pages_messaging,instagram_manage_messages
META_OAUTH_SCOPES=
META_REDIRECT_URI=http://127.0.0.1:4000/integrations/meta/callback
OAUTH_STATE_SECRET=
WEB_APP_BASE_URL=http://127.0.0.1:3000
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_AUTH_BASE_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:4000/integrations/tiktok/callback
TIKTOK_DIRECT_POST_APPROVED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
YOUTUBE_API_AUDITED=0
YOUTUBE_DAILY_UPLOAD_LIMIT=100
TIKTOK_VERIFIED_MEDIA_PREFIXES=http://localhost:9000/social-v1/
PUBLIC_MEDIA_BASE_URL=

# Optional Windows Browser Gateway / GPMLogin
CORE_API_URL=http://127.0.0.1:4000
BROWSER_NODE_ID=local-browser-node
BROWSER_NODE_KEY=
BROWSER_REGISTRATION_TOKEN=
BROWSER_GATEWAY_HOST=127.0.0.1
BROWSER_GATEWAY_BIND=127.0.0.1
BROWSER_GATEWAY_PORT=4010
BROWSER_MAX_CONCURRENCY=2
BROWSER_HEARTBEAT_MS=15000
GPMLOGIN_BASE_URL=http://127.0.0.1:9495/api/v1
GPMLOGIN_ALLOW_NON_LOOPBACK=0
FACEBOOK_GPM_PROFILE_ID=
INSTAGRAM_GPM_PROFILE_ID=
THREADS_GPM_PROFILE_ID=
TIKTOK_GPM_PROFILE_ID=

# Ops
DEBUG_ARTIFACT_DIR=./debug-artifacts
DEBUG_RETENTION_DAYS=7
BACKUP_DIR=./backups
TARGET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_v1_restore
CONFIRM_RESTORE=NO
