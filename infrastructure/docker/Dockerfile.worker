FROM node:24-bookworm-slim AS whisper-build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake curl g++ git make \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch v1.9.4 https://github.com/ggml-org/whisper.cpp.git /src/whisper.cpp \
    && cmake -S /src/whisper.cpp -B /src/whisper.cpp/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /src/whisper.cpp/build --config Release --target whisper-cli -j 2
RUN mkdir -p /opt/whisper \
    && curl -fL --retry 3 -o /opt/whisper/ggml-large-v3.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/c521a4b02f422512d734391fdf08bb08c0862f68/ggml-large-v3.bin \
    && echo '64d182b440b98d5203c4f9bd541544d84c605196c4f7b845dfa11fb23594d1e2  /opt/whisper/ggml-large-v3.bin' | sha256sum -c -

FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable
COPY . .
COPY --from=whisper-build /src/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper-build /opt/whisper/ggml-large-v3.bin /opt/whisper/ggml-large-v3.bin
RUN pnpm install --frozen-lockfile --prod=false && pnpm db:generate
ENV NODE_ENV=production
CMD ["node", "--experimental-strip-types", "apps/worker/src/entry.ts"]
